{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-xcf-ai",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "routes": [{ "pattern": "go.xcf.ai", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GoRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GoRoom"] }],
  "observability": { "enabled": true }
}
